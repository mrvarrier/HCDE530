# Google PageSpeed Insights API Key (Optional but recommended)
# Get your free API key at: https://developers.google.com/speed/docs/insights/v5/get-started
# Free tier: 25,000 requests per day
VITE_PAGESPEED_API_KEY=your_api_key_here

# Backend API URL (for real web scraping)
# Leave empty for local development, set for production
VITE_BACKEND_URL=https://your-backend.vercel.app/api

# Feature Flags
# Enable real web scraping (requires backend to be deployed)
VITE_ENABLE_SCRAPING=false
